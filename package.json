{
  "name": "edu7",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive learning platform — clean layered rebuild (API + Web)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/preflight-dev.mjs && npm run db:setup && concurrently --names \"db,api,web\" --prefix-colors \"magenta,cyan,green\" \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\"",
    "setup": "node scripts/db-setup.mjs --force",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:api-only": "tsx watch src/main.ts",
    "build": "npm --prefix web run build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "tsx scripts/check-architecture.ts",
    "verify": "npm run typecheck && npm run arch:check && npm test",
    "db:dev": "node scripts/dev-db.mjs",
    "db:reset": "node scripts/dev-db.mjs --fresh",
    "db:apply": "node scripts/apply-migrations.mjs",
    "db:baseline": "node scripts/generate-baseline.mjs",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/setup-schema-engine.mjs && node scripts/prisma-generate.mjs && node scripts/install-web-deps.mjs",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@prisma/driver-adapter-utils": "^7.10.0",
    "@prisma/schema-engine-wasm": "^7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "prisma": "^7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
