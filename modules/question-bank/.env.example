# Example environment variables for modules/question-bank

# Copy this file to .env and edit values before running the service.

# PostgreSQL connection used for runtime
# Example: postgresql://qb_user:qb_pass@localhost:5432/question_bank_dev
DATABASE_URL=postgresql://qb_user:qb_pass@localhost:5432/question_bank_dev

# Optional: separate DB for integration tests (SQLite local or Postgres test DB)
# Example for SQLite:
# TEST_DATABASE_URL=file:./tmp-test.db
TEST_DATABASE_URL=file:./tmp-test.db

# JWT secret for signing tokens (replace with secure secret)
JWT_SECRET=replace-with-secure-secret

# App port
PORT=4001

# Node environment
NODE_ENV=development
