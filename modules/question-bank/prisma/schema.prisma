generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Reduced schema for standalone Question Bank module.
// This schema is intentionally self-contained: it removes relations to the old monolith
// (User, School, Textbook, etc.) and keeps only the models required by the question-bank
// service. External references (authors, schools) are stored as plain string IDs so the
// schema can operate on a separate database without depending on the rest of the system.

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  FILL_BLANK
  MATCHING
  ORDERING
  ESSAY
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model Subject {
  id    String  @id @default(uuid()) @db.Uuid
  key   String  @unique
  name  String

  grades Grade[]
  units  Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  name  String

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        String  @id @default(uuid()) @db.Uuid
  key       String  @unique
  title     String
  subjectId String? @db.Uuid
  gradeId   String? @db.Uuid

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  title    String
  unitId   String  @db.Uuid

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id          String          @id @default(uuid()) @db.Uuid
  key         String          @unique
  type        QuestionType
  text        String
  lessonId    String          @db.Uuid
  hint        String?
  explanation String?
  points      Int             @default(1)
  answerData  Json?
  metadata    Json?
  status      PublicationStatus @default(DRAFT)

  choices     QuestionChoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuestionChoice {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @db.Uuid
  key        String
  text       String
  orderIndex Int    @default(0)

  @@index([questionId])
}

model ImportJob {
  id         String   @id @default(uuid()) @db.Uuid
  jobType    String
  status     String   @default("PENDING")
  inputMeta  Json?
  createdBy  String?
  createdAt  DateTime @default(now())
  completedAt DateTime?

  items ImportItem[]
}

model ImportItem {
  id               String @id @default(uuid()) @db.Uuid
  jobId            String @db.Uuid
  canonicalQuestion Json
  fingerprint      String
  validationErrors  Json?
  action           String  @default("PREVIEW")

  @@index([jobId])
}

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  title       String
  description String?
  isAdaptive  Boolean  @default(false)
  timeLimitMins Int?
  passingScore Float   @default(0.5)
  status      PublicationStatus @default(DRAFT)

  items ExamItem[]
  attempts Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamItem {
  id         String @id @default(uuid()) @db.Uuid
  examId     String @db.Uuid
  questionId String @db.Uuid
  orderIndex Int    @default(0)
  points     Int    @default(1)

  @@index([examId])
}

model Attempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  learnerId String?
  examId    String?  @db.Uuid
  status    String   @default("IN_PROGRESS")
  startedAt DateTime @default(now())
  submittedAt DateTime?

  answers AttemptAnswer[]
}

model AttemptAnswer {
  id         String @id @default(uuid()) @db.Uuid
  attemptId  String @db.Uuid
  questionId String @db.Uuid
  payload    Json
  pointsAwarded Int?
  verdict    String?

  @@index([attemptId])
}
