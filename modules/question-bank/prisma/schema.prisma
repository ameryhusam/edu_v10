generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  ARCHIVED
}

enum RoleName {
  SYSTEM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  CONTENT_AUTHOR
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentNodeType {
  UNIT
  SECTION
}

enum TextbookPart {
  PART_1
  PART_2
}

enum ContentAssetType {
  TEXTBOOK_PDF
  UNIT_PDF
  LESSON_PDF
  PAGE_IMAGE
  PAGE_TEXT
  RESOURCE_FILE
  IMAGE_SUMMARY
  AUDIO
  VIDEO
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  FILL_BLANK
  MATCHING
  ORDERING
  ESSAY
}

enum QuestionOrigin {
  TEXTBOOK
  TEACHER
  MINISTERIAL
  AI
  UNKNOWN
}

enum QuestionVisibility {
  PRIVATE
  SCHOOL
  SUBMITTED_FOR_REVIEW
  GLOBAL
}

enum TextbookQuestionRole {
  EXERCISE
  SELF_TEST
  REVIEW
  OTHER
}

enum AttemptKind {
  PRACTICE
  LESSON_CHECK
  EXAM
  REVIEW
  DIAGNOSTIC
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
  EXPIRED
}

enum Verdict {
  CORRECT
  INCORRECT
  PARTIALLY_CORRECT
  SKIPPED
  INVALID
  UNGRADABLE
  REQUIRES_MANUAL_REVIEW
}

enum RemediationTrigger {
  MISCONCEPTION
  MASTERY_GAP
}

enum RemediationStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum AssignmentOrigin {
  TEACHER
  PARENT
  REMEDIAL
  ADAPTIVE
  SELF
}

enum InstructionalActivityType {
  LESSON
  CONCEPT
  EXAM
  REVIEW_SET
  REMEDIATION_PLAN
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ObligationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  WAIVED
}

enum ActivityType {
  REMEDIATE
  REVIEW
  UNBLOCK
  LEARN
  PRACTISE
  ASSESS
  ADVANCE
}

enum ResourceKind {
  READING
  VIDEO
  WORKED_EXAMPLE
  FLASHCARD_DECK
  REMEDIAL
  TEXTBOOK_PAGE
}

enum AiTask {
  EXPLAIN_CONCEPT
  ANSWER_QUESTION
  GENERATE_HINT
  GENERATE_QUESTIONS
  GRADE_ESSAY
  SUMMARISE_PROGRESS
  REVIEW_CONTENT
}

enum AiPurpose {
  TUTORING
  CONTENT_GENERATION
  CONTENT_REVIEW
}

enum ReviewReportStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  key          String     @unique
  email        String?    @unique
  username     String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  lastLoginAt  DateTime?

  roles           UserRole[]
  sessions        Session[]
  learnerProfile  LearnerProfile?
  educatorProfile EducatorProfile?
  guardianProfile GuardianProfile?
  auditEntries    AuditEntry[]
  aiInteractions  AiInteraction[]
  requestedContentReviews ContentReviewReport[]
  authoredPlans     InstructionalPlan[] @relation("PlanAuthor")
  waivedObligations LearnerObligation[] @relation("ObligationWaiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

