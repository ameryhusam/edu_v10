generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"

}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  ARCHIVED
}

enum RoleName {
  SYSTEM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  CONTENT_AUTHOR
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentNodeType {
  UNIT
  SECTION
}

enum TextbookPart {
  PART_1
  PART_2
}

enum ContentAssetType {
  TEXTBOOK_PDF
  UNIT_PDF
  LESSON_PDF
  PAGE_IMAGE
  PAGE_TEXT
  RESOURCE_FILE
  IMAGE_SUMMARY
  AUDIO
  VIDEO
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  FILL_BLANK
  MATCHING
  ORDERING
  ESSAY
}

enum QuestionOrigin {
  TEXTBOOK
  TEACHER
  MINISTERIAL
  AI
  UNKNOWN
}

enum QuestionVisibility {
  PRIVATE
  SCHOOL
  SUBMITTED_FOR_REVIEW
  GLOBAL
}

enum TextbookQuestionRole {
  EXERCISE
  SELF_TEST
  REVIEW
  OTHER
}

enum AttemptKind {
  PRACTICE
  LESSON_CHECK
  EXAM
  REVIEW
  DIAGNOSTIC
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
  EXPIRED
}

enum Verdict {
  CORRECT
  INCORRECT
  PARTIALLY_CORRECT
  SKIPPED
  INVALID
  UNGRADABLE
  REQUIRES_MANUAL_REVIEW
}

enum RemediationTrigger {
  MISCONCEPTION
  MASTERY_GAP
}

enum RemediationStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum AssignmentOrigin {
  TEACHER
  PARENT
  REMEDIAL
  ADAPTIVE
  SELF
}

enum InstructionalActivityType {
  LESSON
  CONCEPT
  EXAM
  REVIEW_SET
  REMEDIATION_PLAN
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ObligationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  WAIVED
}

enum ActivityType {
  REMEDIATE
  REVIEW
  UNBLOCK
  LEARN
  PRACTISE
  ASSESS
  ADVANCE
}

enum ResourceKind {
  READING
  VIDEO
  WORKED_EXAMPLE
  FLASHCARD_DECK
  REMEDIAL
  TEXTBOOK_PAGE
}

enum AiTask {
  EXPLAIN_CONCEPT
  ANSWER_QUESTION
  GENERATE_HINT
  GENERATE_QUESTIONS
  GRADE_ESSAY
  SUMMARISE_PROGRESS
  REVIEW_CONTENT
}

enum AiPurpose {
  TUTORING
  CONTENT_GENERATION
  CONTENT_REVIEW
}

enum ReviewReportStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  key          String     @unique
  email        String?    @unique
  username     String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  lastLoginAt  DateTime?

  roles           UserRole[]
  sessions        Session[]
  learnerProfile  LearnerProfile?
  educatorProfile EducatorProfile?
  guardianProfile GuardianProfile?
  auditEntries    AuditEntry[]
  aiInteractions  AiInteraction[]
  requestedContentReviews ContentReviewReport[]
  authoredPlans     InstructionalPlan[] @relation("PlanAuthor")
  waivedObligations LearnerObligation[] @relation("ObligationWaiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?

  rotatedToId  String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model UserRole {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  role     RoleName

  schoolId String?  @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@unique([userId, role, schoolId])
  @@index([userId])
  @@map("user_roles")
}

model LearnerProfile {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique
  userId String @unique @db.Uuid

  xpTotal        Int       @default(0)
  level          Int       @default(1)
  streakDays     Int       @default(0)
  lastActivityAt DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  masteryRecords  ConceptMastery[]
  evidence        MasteryEvidence[]
  attempts        Attempt[]
  misconceptions  LearnerMisconception[]
  guardians       GuardianLink[]
  xpLedger        XpLedgerEntry[]
  decisionLog     LearningDecisionLog[]
  obligations     LearnerObligation[]
  remediation     RemediationEpisode[]
  targetedPlans   InstructionalPlan[] @relation("TargetedInstructionalPlans")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learner_profiles")
}

model EducatorProfile {
  id           String  @id @default(uuid()) @db.Uuid
  key          String  @unique
  userId       String  @unique @db.Uuid
  employeeCode String?

  specialty    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectSpecialties EducatorSubjectSpecialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educator_profiles")
}

model EducatorSubjectSpecialty {
  id         String @id @default(uuid()) @db.Uuid
  educatorId String @db.Uuid
  subjectId  String @db.Uuid

  educator EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([educatorId, subjectId])
  @@index([subjectId])
  @@map("educator_subject_specialties")
}

model GuardianProfile {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique
  userId String @unique @db.Uuid

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  children GuardianLink[]

  createdAt DateTime @default(now())

  @@map("guardian_profiles")
}

model GuardianLink {
  id         String  @id @default(uuid()) @db.Uuid
  guardianId String  @db.Uuid
  learnerId  String  @db.Uuid
  relation   String?
  isVerified Boolean @default(false)

  guardian GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  learner  LearnerProfile  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guardianId, learnerId])
  @@map("guardian_links")
}

model School {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  name     String
  city     String?
  isActive Boolean @default(true)

  roles       UserRole[]
  enrollments Enrollment[]
  plans InstructionalPlan[]
  adoptions   TextbookAdoption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)

  terms       Term[]
  adoptions   TextbookAdoption[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())

  @@map("academic_years")
}

model Term {
  id             String @id @default(uuid()) @db.Uuid
  key            String @unique
  academicYearId String @db.Uuid
  ordinal        Int
  name           String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  plans InstructionalPlan[]
  textbookAdoptions TextbookAdoption[]

  @@unique([academicYearId, ordinal])
  @@map("terms")
}

model Grade {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  ordinal  Int     @unique
  name     String
  stage    String?

  isActive Boolean @default(true)

  textbooks   Textbook[]
  enrollments Enrollment[]
  plans InstructionalPlan[]
  subjectLinks GradeSubject[]

  @@map("grades")
}

model Subject {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  name     String
  nameEn   String?

  standardGradeLevels Int[] @default([])
  isActive Boolean @default(true)

  textbooks Textbook[]
  gradeLinks GradeSubject[]
  teacherSpecialties EducatorSubjectSpecialty[]

  @@map("subjects")
}

model GradeSubject {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  gradeId   String   @db.Uuid
  subjectId String   @db.Uuid

  isActive  Boolean  @default(true)

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
  @@map("grade_subjects")
}

model Enrollment {
  id             String  @id @default(uuid()) @db.Uuid
  key            String  @unique
  learnerId      String  @db.Uuid
  schoolId       String  @db.Uuid
  academicYearId String  @db.Uuid
  termId         String  @db.Uuid
  gradeId        String  @db.Uuid
  isCurrent      Boolean @default(true)

  learner      LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)

