      "difficultyHint": 0.35
    },
    {
      "key": "MATH-G07-C-UNION-OF-SETS",
      "gradeId": "G07",
      "lessonKey": "EDU-MATH-G07-P1-ED2026-U01-L07",
      "orderIndex": 1,
