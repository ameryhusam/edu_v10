// Edu7 — canonical data model.
//
// Design rules for this file, applied without exception:
//
//  1. ONE baseline migration. The legacy project accumulated 20+ overlapping
//     migrations that contradicted each other; that history is not carried
//     forward. This schema IS the starting point.
//  2. Enums are real Postgres enums, not free-text strings. A status typo
//     should be a compile error, not a support ticket.
//  3. Every business entity carries `id` (surrogate, internal) AND `key`
//     (canonical, deterministic, external). See shared/kernel/identifiers.ts.
//  4. Money-like or belief-like floats are named for what they mean and are
//     always bounded in [0,1] by the domain layer.
//  5. Deletes are restricted by default. Content that learner evidence points
//     at must not vanish; use lifecycle status instead.
//  6. Tables are grouped by bounded context, and cross-context references go
//     through keys, never through reaching into another context's internals.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts, not here, so the
  // schema stays environment-free and can be read safely by any tool.
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  ARCHIVED
}

enum RoleName {
  SYSTEM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  CONTENT_AUTHOR
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentNodeType {
  UNIT
  BRANCH
  SECTION
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  FILL_BLANK
  MATCHING
  ORDERING
  ESSAY
}

/// Where a question actually came from — NOT how it entered Edu7.
///
/// Import is deliberately absent. Importing is an ingestion METHOD: a textbook
/// question that arrives in a file is still TEXTBOOK, and a teacher's question
/// that arrives the same way is still TEACHER. The importer must state the real
/// origin. Batch/file bookkeeping belongs to the future Imports capability, not
/// to the Question domain.
///
/// UNKNOWN exists for historical rows whose provenance cannot be established.
/// It is never inferred: alignment with a textbook lesson is NOT evidence that
/// a question was printed in that textbook.
enum QuestionOrigin {
  TEXTBOOK
  TEACHER
  MINISTERIAL
  AI
  UNKNOWN
}

/// Who may see and reuse a question before it joins the official bank.
///
/// This is ownership/visibility, not provenance: a teacher-authored question is
/// still `origin = TEACHER` whether it is private, school-shared, or submitted
/// for global review.
enum QuestionVisibility {
  PRIVATE
  SCHOOL
  SUBMITTED_FOR_REVIEW
  GLOBAL
}

/// What an original textbook question was printed AS.
///
/// Null for every non-textbook question — a teacher's item has no printed role.
/// Meaningful only when `origin = TEXTBOOK`, which the domain enforces.
enum TextbookQuestionRole {
  EXERCISE
  SELF_TEST
  REVIEW
  OTHER
}

enum AttemptKind {
  PRACTICE
  LESSON_CHECK
  EXAM
  REVIEW
  DIAGNOSTIC
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
  EXPIRED
}

enum Verdict {
  CORRECT
  INCORRECT
  PARTIALLY_CORRECT
  SKIPPED
  INVALID
  UNGRADABLE
  REQUIRES_MANUAL_REVIEW
}

enum ActivityType {
  REMEDIATE
  REVIEW
  UNBLOCK
  LEARN
  PRACTISE
  ASSESS
  ADVANCE
}

/// Why a remediation episode was opened. Deliberately only two: a single
/// wrong answer is noise (BKT smooths it), decay is normal forgetting, and a
/// locked prerequisite is a gap on the PREREQUISITE concept — where an episode
/// is already open. See docs/REMEDIATION-GATE.md §3.
enum RemediationTrigger {
  MISCONCEPTION
  MASTERY_GAP
}

/// There is no DISMISSED state and no manual close: an episode opened by
/// evidence is closed by evidence. Legacy let a teacher PATCH `masteryAchieved`
/// (learning-plans.controller.ts:524), which made "did remediation work?" an
/// assertion rather than a measurement.
enum RemediationStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

/// Who committed the learner to the work. Legacy inferred this from which
/// foreign key was non-null (`teacherPlanId` → TEACHER); a first-class column
/// removes the inference.
enum AssignmentOrigin {
  TEACHER
  PARENT
  REMEDIAL
  ADAPTIVE
  SELF
}

/// What a plan points at. A closed vocabulary rather than one nullable foreign
/// key per assignable thing: legacy took `lessonId`, so assigning an exam
/// required a whole second mechanism instead of a new value here.
enum InstructionalActivityType {
  LESSON
  CONCEPT
  EXAM
  REVIEW_SET
  REMEDIATION_PLAN
}

/// Lifecycle of the authored intent, distinct from any learner's status.
enum PlanStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// Per-learner obligation status. Every value except WAIVED is DERIVED from
/// the completion policy — see docs/ASSIGNMENT-GATE.md §2 case 5.
enum ObligationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  WAIVED
}

enum ResourceKind {
  READING
  VIDEO
  WORKED_EXAMPLE
  FLASHCARD_DECK
  REMEDIAL
  TEXTBOOK_PAGE
}

enum AiTask {
  EXPLAIN_CONCEPT
  ANSWER_QUESTION
  GENERATE_HINT
  GENERATE_QUESTIONS
  GRADE_ESSAY
  SUMMARISE_PROGRESS
  REVIEW_CONTENT
}


// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(uuid()) @db.Uuid
  key          String     @unique // usr_<slug> — stable across environments
  email        String?    @unique
  username     String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  lastLoginAt  DateTime?

  roles           UserRole[]
  sessions        Session[]
  learnerProfile  LearnerProfile?
  educatorProfile EducatorProfile?
  guardianProfile GuardianProfile?
  auditEntries    AuditEntry[]
  aiInteractions  AiInteraction[]
  requestedContentReviews ContentReviewReport[]
  authoredPlans     InstructionalPlan[] @relation("PlanAuthor")
  waivedObligations LearnerObligation[] @relation("ObligationWaiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

/// A refresh token that the server can revoke.
///
/// A self-contained JWT cannot be withdrawn before it expires, which makes
/// "log out" a gesture rather than a control: a stolen token keeps working.
/// Storing the session server-side is what makes logout, "sign out everywhere",
/// and killing a compromised session real.
///
/// Only a HASH of the token is stored. A leaked database must not yield usable
/// credentials.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this session is replaced by a refresh, so token reuse after
  /// rotation is detectable rather than silent.
  rotatedToId  String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model UserRole {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  role     RoleName
  // Roles are scoped: a TEACHER at school A is not a TEACHER at school B.
  schoolId String?  @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@unique([userId, role, schoolId])
  @@index([userId])
  @@map("user_roles")
}

model LearnerProfile {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique // lrn_<slug> — the learnerKey used across all contexts
  userId String @unique @db.Uuid

  // Engagement state. Deliberately NOT mastery: gamification must never be
  // able to influence a pedagogical decision.
  xpTotal        Int       @default(0)
  level          Int       @default(1)
  streakDays     Int       @default(0)
  lastActivityAt DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  masteryRecords  ConceptMastery[]
  evidence        MasteryEvidence[]
  attempts        Attempt[]
  misconceptions  LearnerMisconception[]
  guardians       GuardianLink[]
  xpLedger        XpLedgerEntry[]
  decisionLog     LearningDecisionLog[]
  obligations     LearnerObligation[]
  remediation     RemediationEpisode[]
  targetedPlans   InstructionalPlan[] @relation("TargetedInstructionalPlans")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learner_profiles")
}

model EducatorProfile {
  id           String  @id @default(uuid()) @db.Uuid
  key          String  @unique
  userId       String  @unique @db.Uuid
  employeeCode String?
  /// Legacy free-text note. Subject specialisation is stored as structured
  /// EducatorSubjectSpecialty rows so a teacher can own more than one subject.
  specialty    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectSpecialties EducatorSubjectSpecialty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("educator_profiles")
}

model EducatorSubjectSpecialty {
  id         String @id @default(uuid()) @db.Uuid
  educatorId String @db.Uuid
  subjectId  String @db.Uuid

  educator EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([educatorId, subjectId])
  @@index([subjectId])
  @@map("educator_subject_specialties")
}

model GuardianProfile {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique
  userId String @unique @db.Uuid

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  children GuardianLink[]

  createdAt DateTime @default(now())

  @@map("guardian_profiles")
}

model GuardianLink {
  id         String  @id @default(uuid()) @db.Uuid
  guardianId String  @db.Uuid
  learnerId  String  @db.Uuid
  relation   String? // father, mother, guardian
  isVerified Boolean @default(false)

  guardian GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  learner  LearnerProfile  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guardianId, learnerId])
  @@map("guardian_links")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: ACADEMIC STRUCTURE
// The stable institutional skeleton. Everything else hangs off these.
// ═══════════════════════════════════════════════════════════════════════════

model School {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique
  name     String
  city     String?
  isActive Boolean @default(true)

  roles       UserRole[]
  enrollments Enrollment[]
  plans InstructionalPlan[]
  adoptions   TextbookAdoption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // "2026-2027"
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)

  terms       Term[]
  adoptions   TextbookAdoption[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())

  @@map("academic_years")
}

model Term {
  id             String @id @default(uuid()) @db.Uuid
  key            String @unique // "2026-2027-T01"
  academicYearId String @db.Uuid
  ordinal        Int // 1-based
  name           String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  plans InstructionalPlan[]
  textbookAdoptions TextbookAdoption[]

  @@unique([academicYearId, ordinal])
  @@map("terms")
}

model Grade {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique // "G07"
  ordinal  Int     @unique
  name     String
  stage    String? // primary / preparatory / secondary
  /// Lifecycle, same shape as Subject.isActive: a retired grade stops taking
  /// NEW enrollments while the historical ones keep pointing at it — the
  /// delete guards already prevent removing a referenced row, and this field
  /// is the softer lever for the (rare) case of a ladder being restructured.
  isActive Boolean @default(true)

  textbooks   Textbook[]
  enrollments Enrollment[]
  plans InstructionalPlan[]
  subjectLinks GradeSubject[]

  @@map("grades")
}

model Subject {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique // "MATH" — uppercase canonical code
  name     String
  nameEn   String?
  /**
   * The national curriculum's offer policy: which grade ORDINALS (1-12) the
   * subject belongs to — the legacy provisioningPolicy.gradeLevels, carried
   * as a real column because it has a real runtime consumer (the grade×subject
   * matrix and its fill-from-policy action). Null means the catalogue claims
   * no standard policy: the matrix leaves the subject to the administrator,
   * and fill never touches it. Ordinals, not keys, because the policy spans
   * grades that may not exist yet in this installation. (Prisma has no
   * optional lists; [] carries the "no policy" meaning.)
   */
  standardGradeLevels Int[] @default([])
  isActive Boolean @default(true)

  textbooks Textbook[]
  gradeLinks GradeSubject[]
  teacherSpecialties EducatorSubjectSpecialty[]

  @@map("subjects")
}

/// Which subject is offered in which grade — the curriculum matrix.
///
/// This is catalogue data, not school data: it says "grade 7 has science",
/// not "THIS school teaches it" — that is a textbook adoption. A grade's
/// subject set drives what an enrolment can expect to find books for, and
/// it is the table the structure screen's matrix edits. Kept as real rows
/// (rather than derived from textbooks) because a subject can be offered
/// before any book exists for it, and inventing textbooks to express the
/// offer would be the tail wagging the dog.
model GradeSubject {
  id        String   @id @default(uuid()) @db.Uuid
  /// "<gradeKey>-<subjectKey>", derived identity — the pair IS the row.
  key       String   @unique
  gradeId   String   @db.Uuid
  subjectId String   @db.Uuid
  /// Same lifecycle shape as Subject.isActive: retiring a link stops NEW
  /// expectations while history keeps pointing at it.
  isActive  Boolean  @default(true)

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeId, subjectId])
  @@index([gradeId])
  @@index([subjectId])
  @@map("grade_subjects")
}

model Enrollment {
  id             String  @id @default(uuid()) @db.Uuid
  key            String  @unique
  learnerId      String  @db.Uuid
  schoolId       String  @db.Uuid
  academicYearId String  @db.Uuid
  termId         String  @db.Uuid
  gradeId        String  @db.Uuid
  isCurrent      Boolean @default(true)

  learner      LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term           @relation(fields: [termId], references: [id], onDelete: Restrict)
  grade        Grade          @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([learnerId, academicYearId, termId])
  @@index([schoolId, academicYearId])
  // Exactly one current enrollment per learner is enforced by the partial
  // unique index "enrollments_one_current_per_learner"
  // (prisma/migrations/20260915000000_enrollments_one_current_per_learner),
  // added there rather than here because Prisma cannot express a filtered
  // index in schema.prisma. This plain index serves the lookup; it is not
  // the constraint.
  @@index([learnerId, isCurrent])
  @@map("enrollments")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: CONTENT
// Textbook → Unit → Lesson → Concept, plus the prerequisite DAG.
// Authoring lives here. Delivery only reads it.
// ═══════════════════════════════════════════════════════════════════════════

/// Physical artifacts stored outside PostgreSQL and tracked by immutable metadata.
enum TextbookPart {
  PART_1
  PART_2
}

enum ContentAssetType {
  TEXTBOOK_PDF
  UNIT_PDF
  LESSON_PDF
  PAGE_IMAGE
  PAGE_TEXT
  RESOURCE_FILE
  IMAGE_SUMMARY
  AUDIO
  VIDEO
}

model Textbook {
  id        String @id @default(uuid()) @db.Uuid
  /// EDU-MATH-G07-P1-ED2026 — subject + grade + physical part + printed edition.
  key       String @unique
  part      TextbookPart
  gradeId   String @db.Uuid
  subjectId String @db.Uuid

  title       String
  description String?
  issuer      String?
  /// Printed edition of the physical book, e.g. "2026" or "REV2". Part of
  /// identity: a new printing is a new textbook. NOT the academic year of use
  /// — which years a book is taught in is recorded by TextbookAdoption.
  edition     String
  isbn        String?
  publishYear Int?
  totalPages  Int?

  // The single lifecycle axis. There is deliberately no `isPublished` boolean
  // beside it: legacy carried both and had to guess when they disagreed
  // (textbook-snapshot.service.ts:653).
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  // No `revision` counter. A corrected book is a new Textbook with a new
  // `edition`; see docs/PUBLISHING-LIFECYCLE-GATE.md §3.

  grade     Grade              @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  subject   Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  units     Unit[]
  resources    LearningResource[]
  pages        TextbookPage[]
  assets      ContentAsset[]
  adoptions    TextbookAdoption[]
  exams        Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, gradeId, part, edition])
  @@index([status])
  @@map("textbooks")
}

/// Which school teaches which printed edition, in which academic year.
/// This is where year-of-use lives: the same printed book is adopted across
/// several years, so the year is a deployment fact, not part of book identity.
model TextbookAdoption {
  id             String @id @default(uuid()) @db.Uuid
  textbookId     String @db.Uuid
  schoolId       String @db.Uuid
  academicYearId String @db.Uuid
  termId       String @db.Uuid

  textbook     Textbook     @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)

  adoptedAt DateTime @default(now())

  @@unique([textbookId, schoolId, academicYearId])
  @@index([academicYearId])
  @@map("textbook_adoptions")
}

model Unit {
  id         String          @id @default(uuid()) @db.Uuid
  /// <textbookKey>-U-ALGEBRA
  key        String          @unique
  /// Frozen at creation. Identity lives here, never in orderIndex, so that
  /// reordering content cannot rename it.
  slug       String
  textbookId String          @db.Uuid
  parentId   String?         @db.Uuid // self-nesting for branches/sections
  name       String
  type       ContentNodeType @default(UNIT)
  /// Presentation only. Freely editable; never part of identity.
  orderIndex Int
  startPage  Int?
  endPage    Int?
  isActive   Boolean         @default(true)
  /// Where this row came from in a previous system. Descriptive ONLY.
  ///
  /// Never an identity: the legacy export reuses one questionKey across
  /// several distinct questions (110 math items under 54 keys), so a unique
  /// constraint here would reject valid content and a lookup by it would
  /// return the wrong row. Identity is the derived `key`; this column exists
  /// so a reviewer comparing against the printed curriculum can still find
  /// the original, and so a second import can be reconciled by hand.
  sourceRef  String?

  textbook Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  parent   Unit?    @relation("UnitTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Unit[]   @relation("UnitTree")
  lessons  Lesson[]
  assets   ContentAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([textbookId, parentId, slug])
  @@unique([textbookId, orderIndex, parentId])
  @@index([textbookId])
  @@map("units")
}

model Lesson {
  id            String  @id @default(uuid()) @db.Uuid
  /// <unitKey>-L-LINEAR-EQUATIONS
  key           String  @unique
  /// Frozen at creation. See Unit.slug.
  slug          String
  unitId        String  @db.Uuid
  name          String
  description   String?
  /// Presentation only. Never part of identity.
  orderIndex    Int
  estimatedMins Int?
  startPage     Int?
  endPage       Int?
  isActive      Boolean @default(true)
  /// Legacy source reference. Descriptive only — see Unit.sourceRef.
  sourceRef     String?

  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  concepts  Concept[]
  attempts  Attempt[]
  questions Question[]
  resources LearningResource[]
  assets    ContentAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, slug])
  @@unique([unitId, orderIndex])
  @@index([unitId])
  @@map("lessons")
}

model Concept {
  id       String @id @default(uuid()) @db.Uuid
  /// <lessonKey>-C-SET-UNION
  key      String @unique
  /// Frozen at creation. Mastery is read by concept key, so a key that moved
  /// with orderIndex would silently return another concept's mastery.
  slug     String
  lessonId String @db.Uuid
  name     String

  description String?
  orderIndex  Int
  // Authored difficulty in [0,1]; calibrated item difficulty lives on questions.
  difficulty  Float   @default(0.5)
  importance  Float   @default(0.5)
  // Per-concept override of the platform mastery threshold.
  masteryThreshold Float @default(0.85)
  isCore      Boolean @default(false)
  isActive    Boolean @default(true)
  pageNumber  Int?
  /// Legacy source reference. Descriptive only — see Unit.sourceRef.
  sourceRef   String?
  /// The concept's name in English, when the curriculum supplies one.
  ///
  /// Carried because the source has it for all 55 maths concepts and it is
  /// real editorial content, not a derived convenience: dropping it would
  /// force a re-translation that could not be checked against the original.
  nameEn      String?
  /// Bloom's taxonomy level as authored: remember | understand | apply | ...
  ///
  /// Free text rather than an enum. The curriculum is the authority on which
  /// levels it uses, and an enum would reject a future level at import time
  /// for no pedagogical reason. Validated on the way in, not by the column.
  bloomsLevel String?

  lesson         Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requires       ConceptPrerequisite[]  @relation("Dependent")
  requiredBy     ConceptPrerequisite[]  @relation("Prerequisite")
  questionLinks  QuestionConcept[]
  masteryRecords ConceptMastery[]
  evidence       MasteryEvidence[]
  misconceptions Misconception[]
  resources      LearningResource[]
  assets         ContentAsset[]
  remediation    RemediationEpisode[]
  learnerIssues  LearnerMisconception[]
  flashcards     Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, slug])
  @@unique([lessonId, orderIndex])
  @@index([lessonId])
  @@map("concepts")
}

model ConceptPrerequisite {
  id             String @id @default(uuid()) @db.Uuid
  conceptId      String @db.Uuid // the gated concept
  prerequisiteId String @db.Uuid // must come first
  // >= 0.7 is treated as a hard gate by the domain; below that it warns.
  strength        Float @default(1.0)
  requiredMastery Float @default(0.7)

  concept      Concept @relation("Dependent", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conceptId, prerequisiteId])
  @@index([conceptId])
  @@index([prerequisiteId])
  @@map("concept_prerequisites")
}

model Misconception {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // <conceptKey>-MIS<fingerprint>
  /// Frozen at creation. See Unit.slug.
  ///
  /// Stored rather than re-derived because the key hashes the slug through a
  /// one-way fingerprint: without this column an export cannot state which
  /// misconception it is describing, and a round-trip loses the row.
  slug        String
  conceptId   String  @db.Uuid
  name        String
  description String
  // The corrective explanation shown when this misconception is diagnosed.
  remediation String?

  concept        Concept                @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  distractors    QuestionChoice[]
  learnerIssues  LearnerMisconception[]
  episodes       RemediationEpisode[]

  createdAt DateTime @default(now())

  @@unique([conceptId, slug])
  @@index([conceptId])
  @@map("misconceptions")
}

/// Physical content artifact. Binary bytes live in ContentStorage; PostgreSQL stores identity,
/// provenance and placement only. The checksum is the content fingerprint used by workspace sync.
model ContentAsset {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique
  assetType    ContentAssetType
  originalName String
  relativePath String
  storageKey   String
  publicUrl    String?
  mimeType     String
  sizeBytes    Int
  sha256       String
  version      Int              @default(1)
  scope        String
  pageStart    Int?
  pageEnd      Int?
  title        String?
  altText      String?
  caption      String?
  isActive     Boolean          @default(true)

  textbookId String  @db.Uuid
  unitId     String? @db.Uuid
  lessonId   String? @db.Uuid
  conceptId  String? @db.Uuid

  textbook  Textbook  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lesson    Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept   Concept?  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  resources LearningResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([textbookId, scope])
  @@index([unitId])
  @@index([lessonId])
  @@index([conceptId])
  @@index([sha256])
  @@map("content_assets")
}

model TextbookPage {
  id         String  @id @default(uuid()) @db.Uuid
  textbookId String  @db.Uuid
  pageNumber Int
  // Extracted text used for AI grounding retrieval. Never learner-authored.
  text       String?
  imageUrl   String?

  textbook Textbook           @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  chunks   ContentChunk[]

  @@unique([textbookId, pageNumber])
  @@map("textbook_pages")
}

/// Retrieval unit for grounded AI. Kept separate from pages because a good
/// retrieval chunk rarely aligns with a physical page boundary.
model ContentChunk {
  id         String  @id @default(uuid()) @db.Uuid
  key        String  @unique
  pageId     String? @db.Uuid
  lessonKey  String?
  conceptKey String?
  text       String
  tokenCount Int?
  // Vector search is added later via pgvector; ordering column kept stable.
  ordinal    Int     @default(0)

  page TextbookPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lessonKey])
  @@index([conceptKey])
  @@map("content_chunks")
}

model LearningResource {
  id         String       @id @default(uuid()) @db.Uuid
  key        String       @unique // <conceptKey>-RES<fingerprint>
  /// Frozen at creation. See Misconception.slug for why it is stored.
  ///
  /// Nullable because a resource may hang off a textbook rather than a
  /// concept, and those are not part of the concept-scoped export.
  slug       String?
  kind       ResourceKind
  title      String
  url        String?
  body       String?
  textbookId String?      @db.Uuid
  conceptId  String?      @db.Uuid
  /// A lesson's own reading. The lesson text a learner sees before the
  /// questions is content of the LESSON, not of one concept — hanging it off
  /// a concept would orphan it the moment a lesson is re-concepted.
  lessonId   String?      @db.Uuid
  /// Presentation only, like Unit.orderIndex. Carried by the package format
  /// and therefore stored: an author's chosen reading order is content, and
  /// dropping it silently reorders material on every re-import.
  orderIndex Int          @default(0)
  pageStart  Int?
  pageEnd    Int?
  estimatedMins Int?
  isActive   Boolean      @default(true)
  /// Physical file/artifact backing this semantic resource, when applicable.
  assetId    String?      @db.Uuid

  textbook Textbook? @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  concept  Concept?  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  asset    ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conceptId, slug])
  @@index([conceptId, kind])
  @@index([lessonId, kind])
  @@map("learning_resources")
}

/// A flashcard: authored content, stored once against a concept.
///
/// Deliberately holds NO scheduling state — no ease factor, no interval, no
/// next-review date. Spaced repetition already lives in
/// `mastery/domain/retention.ts`, and a second scheduler owned by flashcards
/// would give two answers to "when should this be reviewed?". Ordering is
/// derived at read time by `learning/domain/flashcard-ordering.ts` from the
/// mastery the learner already has.
///
/// Nor does it hold per-learner state. A card is content; what the learner
/// knows is mastery. Legacy conflated the two and ended up unable to change a
/// card's wording without discarding the review history attached to it.
model Flashcard {
  id        String @id @default(uuid()) @db.Uuid
  key       String @unique
  conceptId String @db.Uuid

  front String
  back  String
  /// Author's hint about which cards matter most, used only to break ties
  /// WITHIN a tier — it can never promote a card above a misconception.
  reviewPriority Float @default(0.5)
  difficulty     Float @default(0.5)
  isActive       Boolean @default(true)

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conceptId, isActive])
  @@map("flashcards")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: ASSESSMENT
// Questions, attempts, grading. Owns evidence production, not mastery.
// ═══════════════════════════════════════════════════════════════════════════

model Question {
  id   String       @id @default(uuid()) @db.Uuid
  key  String       @unique
  type QuestionType
  text String

  /// The lesson this question belongs to. MANDATORY.
  ///
  /// Previously the lesson was reached only *through* the primary concept,
  /// which made a concept compulsory for a structural reason rather than a
  /// pedagogical one: every question needed a concept purely so its key could
  /// be derived. Placement and diagnosis are different questions — "where does
  /// this item live" is always answerable, "which concept does it measure" is
  /// an authoring decision that may legitimately still be pending.
  lessonId String @db.Uuid

  hint        String?
  explanation String?
  points      Int     @default(1)

  /// Provenance. Descriptive metadata only: origin must never be read as a
  /// pedagogical rule inside adaptive selection, remediation or mastery.
  /// Defaults to UNKNOWN so a row can never silently claim to be book content.
  origin       QuestionOrigin        @default(UNKNOWN)
  /// Only meaningful when origin = TEXTBOOK; null otherwise.
  textbookRole TextbookQuestionRole?
  /// Legacy source reference. Descriptive only — see Unit.sourceRef.
  ///
  /// Emphatically not unique here: the legacy maths export reuses a single
  /// questionKey across up to three distinct questions in the same lesson.
  sourceRef    String?

  /// Optional ownership for non-official bank items. Official textbook,
  /// ministerial and reviewed items usually remain GLOBAL; teacher items stay
  /// scoped until a reviewer promotes them. Stored as ids without relations so
  /// the Assessment context does not acquire Identity/Catalogue write semantics.
  authorUserId String? @db.Uuid
  schoolId     String? @db.Uuid
  visibility   QuestionVisibility @default(GLOBAL)

  // IRT parameters. `a`/`b`/`c` are the calibrated truth used by CAT;
  // `difficulty01` is the authored estimate used before calibration.
  irtDiscrimination Float @default(1.0)
  irtDifficulty     Float @default(0.0)
  irtGuessing       Float @default(0.25)
  difficulty01      Float @default(0.5)

  // Live statistics, updated by the analytics projector, never by hand.
  timesAdministered Int   @default(0)
  correctRate       Float @default(0)
  avgSecondsToAnswer Float @default(0)

  status PublicationStatus @default(DRAFT)

  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  choices   QuestionChoice[]
  answerKey AnswerKey?
  /// Optional. An item with no link is placed but not yet diagnostic: it can
  /// be reviewed and re-linked, and until then it produces no mastery evidence
  /// and is refused by the exam builder.
  concepts  QuestionConcept[]
  examItems ExamItem[]
  responses AttemptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  /// Question Bank filtering: "book exercises only", "everything but book items".
  @@index([origin, textbookRole])
  /// Teacher-scoped drafts and school-shared exercises.
  @@index([schoolId, visibility])
  @@index([authorUserId, visibility])
  /// "Every question in this lesson", including the unlinked ones — which is
  /// exactly the list the re-linking screen is built from.
  @@index([lessonId])
  @@map("questions")
}

model QuestionChoice {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @db.Uuid
  text       String
  orderIndex Int
  // A distractor that maps to a named misconception turns a wrong answer into
  // a diagnosis. This link is what powers targeted remediation.
  misconceptionId String? @db.Uuid
  feedback        String?

  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  misconception Misconception? @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)

  @@unique([questionId, orderIndex])
  @@index([questionId])
  @@map("question_choices")
}

/// Answer keys are a separate table so they can be excluded from learner-facing
/// queries by construction rather than by remembering to strip a field.
model AnswerKey {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @unique @db.Uuid

  correctChoiceIds String[] @default([])
  acceptedTexts    String[] @default([])
  numericMin       Float?
  numericMax       Float?
  expectedOrder    String[] @default([])
  expectedPairs    Json?
  caseSensitive    Boolean  @default(false)
  allowPartialCredit Boolean @default(true)
  /// Rubric criteria for ESSAY items, consumed by AI-assisted grading.
  rubric Json?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answer_keys")
}

model QuestionConcept {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  conceptId  String  @db.Uuid
  // Evidence weight multiplier: a question can measure a concept only partly.
  weight     Float   @default(1.0)
  isPrimary  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([questionId, conceptId])
  @@index([conceptId])
  @@map("question_concepts")
}

model Exam {
  id         String  @id @default(uuid()) @db.Uuid
  key        String  @unique
  textbookId String? @db.Uuid
  /// Classroom exams use the same ownership vocabulary as teacher-bank questions:
  /// a teacher may publish their own school/private exam, while global official
  /// exams remain an administrator/content-author bank item.
  authorUserId String? @db.Uuid
  schoolId String? @db.Uuid
  visibility QuestionVisibility @default(GLOBAL)
  title      String
  description String?

  isAdaptive   Boolean @default(false)
  timeLimitMins Int?
  passingScore Float   @default(0.5)
  // Adaptive stopping configuration; ignored for fixed-form exams.
  minItems     Int     @default(5)
  maxItems     Int     @default(25)
  targetStandardError Float @default(0.3)

  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?

  textbook Textbook?  @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  items    ExamItem[]
  attempts Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, visibility])
  @@index([authorUserId, visibility])
  @@map("exams")
}

model ExamItem {
  id         String @id @default(uuid()) @db.Uuid
  examId     String @db.Uuid
  questionId String @db.Uuid
  orderIndex Int
  points     Int    @default(1)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@map("exam_items")
}

model Attempt {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique
  learnerId String        @db.Uuid
  kind      AttemptKind
  status    AttemptStatus @default(IN_PROGRESS)

  lessonKey String?
  lessonId  String? @db.Uuid
  examId    String? @db.Uuid

  score           Float?
  maxScore        Float?
  correctCount    Int?
  incorrectCount  Int?
  pendingReviewCount Int?
  // Ability estimate at submission, for adaptive attempts.
  thetaFinal      Float?
  standardError   Float?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson  Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exam    Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  items   AttemptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId, status])
  @@index([learnerId, kind])
  @@map("attempts")
}

/// One graded answer. Append-only: an attempt item is never edited after
/// grading, because evidence must remain replayable. Regrades create a new row
/// with a bumped evaluator version.
model AttemptItem {
  id         String @id @default(uuid()) @db.Uuid
  attemptId  String @db.Uuid
  questionId String @db.Uuid

  rawAnswer        Json
  verdict          Verdict
  scoreEarned      Float?
  scorePossible    Float   @default(1)
  normalizedAnswer String?
  /// Ordered list of normalisation steps actually applied. Explains the verdict.
  normalizationApplied String[] @default([])
  /// Which grading rulebook produced this verdict. Never recompute across versions.
  evaluatorVersion String
  evaluationNote   String?

  /// Human reviewer that converted a pending essay into a graded item.
  manualGradedByUserId String? @db.Uuid
  manualGradedAt       DateTime?
  manualFeedback       String?

  timeSpentSeconds Int?
  answeredAt       DateTime

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([answeredAt])
  @@index([verdict, answeredAt])
  @@map("attempt_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: MASTERY
// Evidence in, belief out. This is the only place mastery is written.
// ═══════════════════════════════════════════════════════════════════════════

/// The immutable evidence stream. Mastery is a pure function of these rows,
/// which is what makes every mastery number reproducible and auditable.
model MasteryEvidence {
  id        String @id @default(uuid()) @db.Uuid
  learnerId String @db.Uuid
  conceptId String @db.Uuid

  questionKey String
  isCorrect   Boolean
  /// Signal strength in [0,1]. 0 = observed but carries no mastery information.
  weight      Float   @default(1)
  verdict     Verdict
  misconceptionKey String?

  /// When the learner ANSWERED. Replay orders by this, never by insertion order.
  observedAt DateTime

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  concept Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([learnerId, conceptId, observedAt])
  @@index([observedAt])
  @@map("mastery_evidence")
}

model ConceptMastery {
  id        String @id @default(uuid()) @db.Uuid
  learnerId String @db.Uuid
  conceptId String @db.Uuid

  /// BKT posterior at the last observation, in [0,1]. NOT decayed.
  mastery    Float @default(0)
  /// Certainty in that estimate, driven by evidence volume.
  confidence Float @default(0)
  /// Memory stability in days; grows with successful spaced review.
  stabilityDays Float @default(1)

  attemptsCount Int @default(0)
  correctCount  Int @default(0)

  /// Decay is applied at READ time from this timestamp — never stored decayed.
  lastObservedAt DateTime?
  recomputedAt   DateTime  @default(now())

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  concept Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([learnerId, conceptId])
  @@index([learnerId])
  @@map("concept_mastery")
}

model LearnerMisconception {
  id              String  @id @default(uuid()) @db.Uuid
  learnerId       String  @db.Uuid
  conceptId       String  @db.Uuid
  misconceptionId String? @db.Uuid

  confidence Float     @default(0.5)
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  /// How many times this misconception has been observed. Repeats matter.
  occurrences Int      @default(1)

  learner       LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  concept       Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  misconception Misconception? @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([learnerId, conceptId, misconceptionId])
  @@index([learnerId, isResolved])
  @@map("learner_misconceptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: LEARNING
// Decisions and engagement. Consumes mastery; never writes it.
// ═══════════════════════════════════════════════════════════════════════════

/// Every adaptive decision is logged with the rule that fired. This is what
/// lets a teacher ask "why was my student shown this?" and get a real answer,
/// and what lets us A/B a pedagogy change with evidence.
model LearningDecisionLog {
  id        String       @id @default(uuid()) @db.Uuid
  learnerId String       @db.Uuid
  activity  ActivityType
  conceptKey String?
  rule      String
  rationale String
  evidence  Json

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  decidedAt DateTime @default(now())

  @@index([learnerId, decidedAt])
  @@map("learning_decision_log")
}

/// XP as an append-only ledger rather than a mutable counter: the balance is
/// always the sum, so it can be recomputed and never silently drifts.
/// An XP award. Append-only: the ledger IS the total.
///
/// There is deliberately no `totalXp` column on LearnerProfile. Legacy kept a
/// running total on StudentProfile alongside the transaction rows, and the two
/// drifted the first time an award failed halfway. Summing an indexed ledger is
/// cheap; reconciling two disagreeing numbers is not.
model XpLedgerEntry {
  id        String @id @default(uuid()) @db.Uuid
  learnerId String @db.Uuid
  amount    Int
  reason    String
  sourceKey String?

  /// Derived from WHAT was rewarded, never from a timestamp.
  ///
  /// Legacy fell back to `xp_<id>_<Date.now()>`, which is unique on every call
  /// — so a retried request paid the learner twice. The unique constraint here
  /// is what makes a replay free rather than merely unlikely.
  idempotencyKey String @unique

  learner LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now())

  @@index([learnerId, awardedAt])
  @@map("xp_ledger")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: INSTRUCTION
// Who was asked to do what, by when. Records commitments, never achievement.
// ═══════════════════════════════════════════════════════════════════════════

/// The authored intent: one row per act of assigning, however many learners
/// it reaches.
///
/// Deliberately absent: any score, mastery or attempt count. An assignment
/// records that something was ASKED, never how well it was DONE — legacy put
/// `masteryAchieved` on its assignment row and then exposed it to PATCH
/// (learning-plans.controller.ts:524). Rule M2 fails the build if that returns.
///
/// Scope is {school, grade, term}, not a class id: a class is a query over
/// Enrollment, not an entity. See docs/CLASS-ROSTER-INVESTIGATION.md.
model InstructionalPlan {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique
  title  String
  instructions String?

  origin       AssignmentOrigin          @default(TEACHER)
  activityType InstructionalActivityType
  /// Key of the referenced lesson/concept/exam. Validated against the plan's
  /// scope before any write (LD-2), resolved through the owning context on read.
  activityKey  String

  /// Recipient scope. A plan targets a cohort; an obligation always names one
  /// learner.
  schoolId String  @db.Uuid
  gradeId  String? @db.Uuid
  termId   String? @db.Uuid

  assignedById String?   @db.Uuid
  /// Optional learner target. When present, materialisation is intentionally
  /// constrained to this learner and never expands to the cohort scope.
  targetLearnerId String? @db.Uuid
  availableAt  DateTime?
  dueAt        DateTime?

  status      PlanStatus @default(DRAFT)
  publishedAt DateTime?

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade      Grade?          @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  term       Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  assignedBy User?           @relation("PlanAuthor", fields: [assignedById], references: [id], onDelete: SetNull)
  targetLearner LearnerProfile? @relation("TargetedInstructionalPlans", fields: [targetLearnerId], references: [id], onDelete: SetNull)
  obligations LearnerObligation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, gradeId, termId])
  @@index([targetLearnerId])
  @@index([status])
  @@map("instructional_plans")
}

/// One learner's obligation under a plan. The unit of status.
///
/// `@@unique([planId, learnerId])` is what makes re-publication idempotent:
/// re-running materialisation after a late enrolment adds the missing learner
/// and touches nobody else.
model LearnerObligation {
  id        String @id @default(uuid()) @db.Uuid
  key       String @unique
  planId    String @db.Uuid
  learnerId String @db.Uuid

  status ObligationStatus @default(PENDING)
  /// Set when status was last recomputed from the completion policy, so a
  /// stale row is visible as stale rather than mistaken for a fresh verdict.
  evaluatedAt DateTime?
  /// The completion gate that currently blocks it, for explainability.
  blockedByGate String?

  startedAt   DateTime?
  completedAt DateTime?

  /// WAIVED is the only asserted transition, and it must say who and why.
  waivedById  String?  @db.Uuid
  waivedAt    DateTime?
  waiverReason String?

  plan     InstructionalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  learner  LearnerProfile    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  waivedBy User?             @relation("ObligationWaiver", fields: [waivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, learnerId])
  @@index([learnerId, status])
  @@index([planId, status])
  @@map("learner_obligations")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTEXT: PLATFORM (audit, AI governance, settings)
// ═══════════════════════════════════════════════════════════════════════════

/// Cost, provenance and safety record for every AI call. Non-optional: an AI
/// feature you cannot audit is an AI feature you cannot ship to schools.
/// A persisted claim that a learner has a specific gap.
///
/// NOT an assignment. It has no due date, no assignee and no submission,
/// because it records the existence of a PROBLEM rather than a task. If a
/// teacher wants the learner to do something about it they publish an
/// InstructionalPlan, which links here — not the other way round.
///
/// Legacy had no such table: remediation was `StudentAssignment.originType =
/// 'REMEDIAL'`, so a gap only existed once a human had created an assignment
/// for it, and the diagnosis the engine produced on every request evaporated.
model RemediationEpisode {
  id        String @id @default(uuid()) @db.Uuid
  /// REM-<trigger initial><fp8>. Derived from learner + concept + openedAt, so
  /// a re-opened gap gets a genuinely new key rather than colliding.
  key       String @unique
  learnerId String @db.Uuid
  conceptId String @db.Uuid

  trigger RemediationTrigger
  status  RemediationStatus  @default(OPEN)

  /// Which wrong model this episode is about. Null for MASTERY_GAP.
  misconceptionId String? @db.Uuid

  /// Stable reason codes, rendered by the interface layer. Never UI copy:
  /// a rule that hardcodes one language cannot serve a bilingual product.
  openedReason   String
  resolvedReason String?
  /// The numbers behind the decision, so a teacher can be shown the basis
  /// rather than being asked to trust "the algorithm".
  openedEvidence Json

  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  learner       LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  concept       Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  misconception Misconception? @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOT @@unique([learnerId, conceptId, trigger]) — that would forbid the
  // re-opening the design requires, since a resolved episode would block a
  // genuine new gap. Uniqueness applies to OPEN episodes only, enforced by a
  // partial index added in the baseline migration:
  //   CREATE UNIQUE INDEX remediation_one_open_per_gap
  //     ON remediation_episodes ("learnerId", "conceptId", trigger, COALESCE("misconceptionId", ...))
  //     WHERE status = 'OPEN';
  @@index([learnerId, status])
  @@index([conceptId, status])
  @@map("remediation_episodes")
}

/// Why the call was made, separate from `task` (the provider prompt shape).
/// Exists so a content author's generation/review quota never shares the
/// same daily ceiling as a learner's tutoring quota — one AI outage or one
/// heavy authoring day must not silently ration a struggling learner's
/// remaining questions for the day.
enum AiPurpose {
  TUTORING
  CONTENT_GENERATION
  CONTENT_REVIEW
}

model AiInteraction {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  task      AiTask
  /// Defaults to TUTORING so every interaction logged before this column
  /// existed keeps its true historical meaning without a backfill.
  purpose    AiPurpose @default(TUTORING)
  providerId String
  modelId    String

  grounded       Boolean
  chunkKeys      String[] @default([])
  refused        Boolean  @default(false)
  refusalReason  String?

  tokensIn  Int?
  tokensOut Int?
  latencyMs Int

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([task, createdAt])
  @@index([purpose, userId, createdAt])
  @@map("ai_interactions")
}

/// One AI-produced review of existing content — read-only advice, never a
/// write path. A human reads it and, if convinced, performs the same write a
/// human author would have performed anyway (createMisconception, editing a
/// question draft, …). The report itself never touches Question, Concept or
/// Misconception rows.
enum ReviewReportStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

model ContentReviewReport {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique

  /// Exactly one of these identifies what was reviewed. Enforced in the
  /// application layer, not the schema — a CHECK constraint expressing
  /// "exactly one of three nullable columns is set" is not worth the SQL
  /// for a table an admin queue reads, not a hot path.
  textbookKey String?
  lessonKey   String?
  questionKey String?

  /// The issues found, as JSON matching `ContentReviewIssue[]` in
  /// `contexts/content/domain/content-review-report.ts`. Not modelled as a
  /// child table: a report is read as a whole or not at all, and an admin
  /// queue has no use for querying "all reports containing a HIGH severity
  /// issue" across the fleet — if that need appears, this JSON is exactly
  /// what a future migration would normalise from.
  issues Json

  status       ReviewReportStatus @default(OPEN)
  providerId   String
  requestedBy  String?            @db.Uuid

  requestedByUser User? @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([textbookKey])
  @@index([lessonKey])
  @@index([questionKey])
  @@map("content_review_reports")
}

model AuditEntry {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @db.Uuid
  action   String
  entity   String
  entityKey String?
  before   Json?
  after    Json?
  ip       String?
  /// Correlates an audit entry with the request that caused it. Answering
  /// "who changed this, in which operation" needs both halves.
  requestId String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityKey])
  @@index([createdAt])
  @@map("audit_entries")
}

model SystemSetting {
  key         String  @id
  value       Json
  description String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
