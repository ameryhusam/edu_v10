# Converted content packages.
#
# Generated, not authored: `node scripts/convert-legacy-curriculum.mjs`
# reproduces them byte-for-byte from legacy/data/demo, which IS committed.
# Storing 1.1 MB of derived JSON would make every regeneration a large,
# unreviewable diff of content nobody edited by hand.
content-packages/

# The previous system, kept for reference and comparison — see legacy/ABOUT-THIS-DIRECTORY.md.
# It is committed, but nothing of its build output is.
legacy/node_modules/
legacy/dist/
legacy/.env

# Edu7 content-preparation data boundaries.
# Source books and generated workspaces stay outside the Python engine.
books_input/*
!books_input/README.md
workspace/*
!workspace/README.md

# Generated local content-engine artifacts
edu7-content-engine/workspaces/
edu7-content-engine/.tmp/

# Local migration backups: temporary working data, never commit.
.local-migration-backups/
