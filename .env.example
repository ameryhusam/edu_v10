# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# APP_PORT, never PORT: the sandboxed container exports PORT=8080 for its own
# router, and binding there makes the app unreachable — the preview routes the
# product port (3000) only. API and UI are served from this ONE port.
APP_PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Default targets the embedded PGlite dev server (node scripts/dev-db.mjs).
# For a real PostgreSQL, point this at it and raise DATABASE_POOL_MAX.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
# PGlite accepts ONE connection at a time; a managed Postgres should use ~10.
DATABASE_POOL_MAX=1

# ─── Auth ───────────────────────────────────────────────────────────────────
# Must be replaced in production — the app refuses to boot with the dev default.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── AI (optional) ──────────────────────────────────────────────────────────
# Leave API keys empty to run on the deterministic extractive provider. The
# platform degrades gracefully; it never hard-depends on a paid API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Tried in order; deterministic is appended automatically if omitted.
AI_PROVIDER_ORDER=gemini,openai,deterministic
AI_DAILY_QUOTA=50

# ─── HTTP ───────────────────────────────────────────────────────────────────
# `*` is fine for local development. In production, set this to a
# comma-separated allow-list of real origins — the app refuses to boot with
# NODE_ENV=production and this left as `*`, because combined with credentialed
# cookies it would let any website read an authenticated user's session.
CORS_ORIGINS=*

# `lax` is correct when the app and API share a site. `none` is required when
# the app is embedded in an iframe on another origin (a sandboxed preview):
# a Lax cookie is silently withheld there, so every refresh 401s with nothing
# in the logs to explain it. `none` requires HTTPS and is downgraded to `lax`
# on a plain-HTTP request rather than emitting a cookie browsers reject.
#
# Defaulted to `none` because this failure is invisible and expensive: sign-in
# returns 200, the dashboard paints, and then the very next request 401s and
# bounces the user back to the login form looking like a wrong password. It
# cost a full debugging session once. On a same-site deployment set it back to
# `lax`, which is the stricter choice.
COOKIE_SAMESITE=none
