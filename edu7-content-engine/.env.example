# Edu7 Content Engine — local Gemini configuration
# Copy this file to .env and NEVER commit the real .env file.

# One key:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OR multiple keys (comma or semicolon separated).
# The engine rotates to the next key after quota/access failures.
# Do not put real keys in this example file.
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3

# Alternative Android/Termux-friendly form:
# GEMINI_API_KEY_1=YOUR_GEMINI_API_KEY_1
# GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
# GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3

# Primary Gemini model.
GEMINI_MODEL=gemini-3.8-flash

# Optional ordered model fallback list.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# Transport controls.
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=120

# Temporary in-process cooldown after quota/access errors.
GEMINI_QUOTA_COOLDOWN_SECONDS=300
