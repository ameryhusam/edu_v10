{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@infra/*": [
        "src/infrastructure/*"
      ],
      "@contexts/*": [
        "src/contexts/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "prisma/seed",
    "scripts"
  ],
  "exclude": [
    ".local-migration-backups",
    "scripts/local_migrations",
    "node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
